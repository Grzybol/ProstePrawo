# Sample environment configuration for the ProstePrawo project.
# Duplicate this file as `.env` and adjust the values to fit your setup.

# Core application settings
PROSTE_PRAWO_DATA_DIR=data
PROSTE_PRAWO_ENABLE_CLOUD_LLM=true
PROSTE_PRAWO_LLM_PROVIDER=openai
PROSTE_PRAWO_OPENAI_MODEL=gpt-4o-mini

# External services
OPENAI_API_KEY=

# Authentication & sessions
PROSTE_PRAWO_SESSION_SECRET_KEY=change-me
PROSTE_PRAWO_ENVIRONMENT=development
PROSTE_PRAWO_SMTP__HOST=
PROSTE_PRAWO_SMTP__PORT=587
PROSTE_PRAWO_SMTP__USERNAME=
PROSTE_PRAWO_SMTP__PASSWORD=
PROSTE_PRAWO_SMTP__SENDER=no-reply@example.com
PROSTE_PRAWO_SMTP__USE_TLS=true
PROSTE_PRAWO_VERIFICATION__BASE_URL=http://localhost:8000
PROSTE_PRAWO_VERIFICATION__TOKEN_TTL_HOURS=48
PROSTE_PRAWO_PASSWORD_RESET__BASE_URL=http://localhost:8000
PROSTE_PRAWO_PASSWORD_RESET__TOKEN_TTL_HOURS=24
PROSTE_PRAWO_TURNSTILE_SITE_KEY=
PROSTE_PRAWO_TURNSTILE_SECRET_KEY=
PROSTE_PRAWO_DISABLE_CLOUDFLARE_TURNSTILE=true
